# Copy to .env and fill in. Loaded automatically by the orchestrators (python-dotenv).
# .env is gitignored; .env.example is the committed template.

# --- Model provider (needed for the matching active_provider in
#     config/providers.yaml; not needed for the 'mock' or 'ollama' providers) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- E2B sandbox (needed only for the Terminal-Bench matrix via
#     orchestrator.e2b_orchestrator; not needed for the local/mock matrix) ---
E2B_API_KEY=
# Set ONLY if you run a self-hosted E2B instance (leave blank for E2B cloud).
E2B_DOMAIN=

# --- Ollama (needed only when active_provider is 'ollama') ---
# The base_url lives in config/providers.yaml; no key is required for local Ollama.
# OLLAMA_HOST=http://localhost:11434

# NOTE: the MARGIN_* variables (MARGIN_ARM, MARGIN_TASK_ID, MARGIN_SEED,
# MARGIN_COMPLEXITY, MARGIN_RUN_DIR, MARGIN_LABELS) are set automatically by the
# orchestrator per run — do NOT set them here.
